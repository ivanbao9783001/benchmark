{
  "schema_version": "top-input/2",
  "task": {
    "id": "{{task.id}}",
    "action": "deploy_and_eval",
    "eval_mode": "perf",
    "on_idle": "release_owned",
    "control_node": "{{node.id}}"
  },
  "nodes": {
    "{{node.id}}": {
      "host": "{{node.host}}",
      "allowed_root": "{{node.allowed_root}}",
      "python": "{{node.python}}",
      "guard_root": "{{node.guard_root}}",
      "model_paths": {
        "{{model.id}}": "{{node.model_path}}"
      },
      "network": null,
      "paths": null,
      "authorization": {
        "preempt_other_processes": false,
        "create_work_root": true
      }
    }
  },
  "deployment": {
    "id": "{{task.id}}",
    "topology": "colocated",
    "model": {
      "id": "{{model.id}}",
      "served_name": "{{model.served_name}}"
    },
    "image": null,
    "instances": [
      {
        "id": "srv",
        "role": "mixed",
        "node": "{{node.id}}",
        "devices": ["{{device.0}}", "{{device.1}}"],
        "args": null,
        "ports": {
          "http": null
        }
      }
    ],
    "endpoint": {
      "instance": "srv",
      "port": "http"
    }
  },
  "evaluation": {
    "tester": {
      "host": "{{tester.host}}",
      "work_root": "{{tester.work_root}}",
      "python": "{{tester.python}}",
      "aisbench": "{{tester.aisbench}}",
      "model_path": "{{tester.model_path}}",
      "datasets": {}
    },
    "dataset": null,
    "params": null
  },
  "deliverables": {
    "local_dir": "{{deliverables.local_dir}}"
  },
  "constraints": [
    "不修改 .agents/ 下的技能与 CLI 源码",
    "不读取历史任务目录、归档或回收站",
    "阶段流程只用 deploy-eval-v2 CLI"
  ]
}
