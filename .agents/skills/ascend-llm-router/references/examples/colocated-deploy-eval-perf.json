{
  "schema_version": "top-input/2",
  "task": {
    "id": "case-perf-01",
    "action": "deploy_and_eval",
    "eval_mode": "perf",
    "on_idle": "release_owned",
    "control_node": "n1"
  },
  "nodes": {
    "n1": {
      "host": "example@192.0.2.11",
      "allowed_root": "/srv/work",
      "python": "/srv/venvs/deploy-eval/bin/python",
      "guard_root": "/srv/guard",
      "model_paths": {
        "qwen3-8b": "/srv/models/Qwen3-8B"
      },
      "network": {
        "ip": "192.0.2.11",
        "interface": "eth0"
      },
      "paths": null,
      "authorization": {
        "preempt_other_processes": false,
        "create_work_root": true
      }
    }
  },
  "deployment": {
    "id": "case-perf-01",
    "topology": "colocated",
    "model": {
      "id": "qwen3-8b",
      "served_name": "qwen3-8b"
    },
    "image": null,
    "instances": [
      {
        "id": "srv",
        "role": "mixed",
        "node": "n1",
        "devices": [6, 7],
        "args": null,
        "ports": {
          "http": 8020
        }
      }
    ],
    "endpoint": {
      "instance": "srv",
      "port": "http"
    }
  },
  "evaluation": {
    "tester": {
      "host": "example@192.0.2.11",
      "work_root": "/srv/work",
      "python": "/srv/venvs/aisbench/bin/python",
      "aisbench": "/srv/src/AISBench",
      "model_path": "/srv/models/Qwen3-8B",
      "datasets": {
        "synthetic": {
          "type": "aisbench_synthetic"
        }
      }
    },
    "dataset": null,
    "params": null
  },
  "deliverables": {
    "local_dir": "deploy-runs"
  },
  "constraints": [
    "不修改 .agents/ 下的技能与 CLI 源码",
    "不读取历史任务目录、归档或回收站",
    "阶段流程只用 deploy-eval-v2 CLI"
  ]
}
