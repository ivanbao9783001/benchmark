{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "operation_id",
    "service_id",
    "case_id",
    "time",
    "execution_status",
    "evidence_status",
    "evaluation_type"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evaluation_type": {
      "enum": [
        "perf",
        "acc"
      ]
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "operation_id": {
      "$ref": "#/$defs/id"
    },
    "service_id": {
      "$ref": "#/$defs/id"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "execution_status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "evidence_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INVALID"
      ]
    },
    "performance_validity": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "INVALID"
      ]
    },
    "accuracy_validity": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "INVALID"
      ]
    },
    "accuracy": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "task",
        "dataset",
        "metric",
        "unit",
        "value",
        "num_samples",
        "scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        },
        "metric": {
          "const": "accuracy"
        },
        "unit": {
          "const": "percent"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "num_samples": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "accuracy_evidence": {
      "type": "object",
      "required": [
        "host",
        "path"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "actual_load": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "maxLength": 1024
    },
    "cleanup_status": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "NOT_REQUESTED"
      ]
    },
    "prefix_metric_status": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED"
      ]
    },
    "performance": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "groups",
        "scope"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "dataset",
              "stage",
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "VERIFIED",
                  "UNVERIFIED"
                ]
              },
              "duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "requests": {
                "type": "integer",
                "minimum": 1
              },
              "request_throughput": {
                "type": "number",
                "minimum": 0,
                "description": "requests/second"
              }
            }
          }
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "framework_log_status": {
      "enum": [
        "COLLECTED",
        "PENDING"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_type": {
            "const": "perf"
          }
        },
        "required": [
          "evaluation_type"
        ]
      },
      "then": {
        "required": [
          "performance_validity"
        ]
      },
      "else": {
        "required": [
          "accuracy_validity"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_type": {
            "const": "acc"
          },
          "accuracy_validity": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "evaluation_type",
          "accuracy_validity"
        ]
      },
      "then": {
        "required": [
          "accuracy"
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    }
  }
}
